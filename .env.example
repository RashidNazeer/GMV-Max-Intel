# This project's ONLY source of configuration. Copy to .env.local and fill in.
# .env.local is git-ignored and never leaves this folder.
#
# Nothing here is shared with any other project. Do not point these at, or read
# them from, another project's secrets file — that is how two codebases end up
# quietly coupled and how the wrong account gets touched.

# ── Browser-visible (VITE_ prefix) ─────────────────────────────────────────
# The anon key is public by design; every row it can reach is decided by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── SERVER ONLY — never prefix these with VITE_ ────────────────────────────
# Vite only exposes VITE_* to the browser, so the absence of that prefix is
# what keeps these out of the bundle. `npm run audit:bundle` proves it.
SUPABASE_SERVICE_ROLE_KEY=
REACHER_API=

# ── Project identifiers (not secrets, but kept together) ───────────────────
GMV_INTEL_ORG_ID=
GMV_INTEL_PROJECT_REF=
GMV_INTEL_DB_PASSWORD=

# ── Local test login, written by scripts/create-user.mjs ───────────────────
BOSS_LOGIN_PASSWORD=
