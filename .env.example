# Client-side (safe to expose — anon key is public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix these with VITE_ — that would bundle them into the
# browser. The Reacher key is account-wide and its scopes include read_write.
# In production these live as Supabase edge-function secrets, not in a file.
REACHER_API=
SUPABASE_SERVICE_ROLE_KEY=
